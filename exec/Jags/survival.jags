model {
  # likelihood
    for (n in 1:N) {
      obs.time[n] ~ dexp(mu[n])
      mu[n] <- exp(eta[n])
    }
    eta <- X %*% beta_reg + beta_0

  # set up betas
    beta[1] <- beta_0
    for (p in 1:P) {
      beta_reg[p] <- alpha[p] * betaLarge[p]
      beta[p+1] <- beta_reg[p]
    }
  # priors
    betaLarge ~ dmnorm(mu_vec, prec_matrix)
    beta_0 ~ dnorm(mu_0, 0.5)
    for (p in 1:P) {
      alpha[p] ~ dbern(prob)
    }
    prob ~ dbeta(spike_a, spike_b)
}
