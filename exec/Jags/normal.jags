model{
  # priors
    beta_0 ~ dcauchy(0.0, 1.0)
    prob ~ dbeta(1.0, 1.0)
    for(p in 1:P){
      betaLarge[p] ~ dnorm(0.0, 0.001)
      #alpha[p] ~ dbern(prob)
      alpha[p] ~ dbern(0.1)
      beta[p] <- alpha[p] * betaLarge[p]
    }
    prec ~ dgamma(1.0,1.0)
  
  # likelihood
    for(n in 1:N){
      mu[n] <- beta_0
      for(p in 1:P){
        mu[n] <- mu[n] + X[n,p] * beta[p]
      }
      time[n] ~ dnorm(mu[n], prec)
    }
}